# ==============================================================================
# BABEL STORE - CONFIGURATION DU NOUVEAU GOOGLE SHEET & COMPTE GOOGLE DÉDIÉ
# ==============================================================================

# ID de votre NOUVEAU Google Sheet (trouvable dans l'URL: docs.google.com/spreadsheets/d/VOTRE_ID_ICI/edit)
GOOGLE_SPREADSHEET_ID=VOTRE_NOUVEL_ID_SHEET_BABEL

# URL de déploiement de votre NOUVELLE application Web Apps Script (/exec)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/VOTRE_NOUVEAU_DEPLOYMENT_ID/exec
PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/VOTRE_NOUVEAU_DEPLOYMENT_ID/exec
PRODUCTS_FEED_URL=https://script.google.com/macros/s/VOTRE_NOUVEAU_DEPLOYMENT_ID/exec
