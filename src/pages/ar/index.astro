---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAvailableColors, getCatalogProducts, getNewArrivalProducts, getPopularProducts, getProducts, getPromotionProducts } from '../../lib/product-source';

const products = await getProducts();
const catalogProducts = getCatalogProducts(products);
const promotions = getPromotionProducts(catalogProducts);
const popularProducts = getPopularProducts(catalogProducts);
const newProducts = getNewArrivalProducts(catalogProducts);
---

<MainLayout locale="ar" title="الرئيسية" description="BUBLE STORE DZ - تشكيلة مختارة من أحدث المنتجات العصرية والعملية بأعلى معايير الجودة في الجزائر.">
  <Hero locale="ar" />

  <section class="section-shell pt-4">
    <div class="container-shell space-y-14">
      <!-- Section Principale : تشكيلة المنتجات -->
      <section>
        <SectionTitle
          eyebrow="تشكيلة BUBLE STORE DZ"
          title="المنتجات المتوفرة"
          copy="منتجات مختارة بعناية لتحسين راحتك اليومية. توصيل سريع لكافة الولايات والدفع عند الاستلام."
        />
        <div
          id="products-showcase-grid-ar"
          class:list={[
            'mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
            catalogProducts.length === 0 ? 'hidden' : ''
          ]}
        >
          {catalogProducts.map((product) => (
            <ProductCard
              product={product}
              locale="ar"
              basePath="/ar"
              availableColors={getAvailableColors(products, product.slug, product.variantGroup, 'ar')}
              detailLabel="عرض المنتج"
              colorsLabel="الألوان"
            />
          ))}
        </div>

        {catalogProducts.length === 0 && (
          <div id="sync-placeholder-ar" class="mt-8 rounded-3xl border border-brand-line bg-white/80 p-12 text-center shadow-soft">
            <p class="text-lg font-semibold text-brand-charcoal">جاري تحديث التشكيلة...</p>
            <p class="mt-2 text-sm text-brand-muted">يتم تحميل المنتجات مباشرة من جدول البيانات. يرجى تحديث الصفحة.</p>
          </div>
        )}
      </section>

      {promotions.length > 0 && catalogProducts.length > 3 && (
        <section>
          <SectionTitle eyebrow="العروض الحصرية" title="منتجات مخفضة" copy="استفد من أفضل التخفيضات المميزة في متجر بابل." />
          <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {promotions.map((product) => (
              <ProductCard
                product={product}
                locale="ar"
                basePath="/ar"
                availableColors={getAvailableColors(products, product.slug, product.variantGroup, 'ar')}
                detailLabel="عرض المنتج"
                colorsLabel="الألوان"
              />
            ))}
          </div>
        </section>
      )}

      <!-- Reassurance Section BUBLE STORE DZ (Arabic) : Bleu Nuit & Grenat Impérial -->
      <section class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-gradient-to-br from-[#0B132B] via-[#101D38] to-[#060B1A] p-8 text-white shadow-premium sm:p-12">
        <!-- Glows -->
        <div class="pointer-events-none absolute -left-16 -top-16 h-80 w-80 rounded-full bg-brand-grenat/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-16 -right-16 h-72 w-72 rounded-full bg-brand-blueaccent/20 blur-3xl"></div>

        <div class="relative max-w-3xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-grenat/50 bg-brand-grenat/20 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-goldsoft shadow-sm backdrop-blur">
            <span class="h-2 w-2 rounded-full bg-brand-grenat animate-pulse"></span>
            ثقتكم أولويتنا
          </span>
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
            تجربة تسوق موثوقة ومريحة مع BUBLE STORE DZ
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-slate-300 sm:text-base">
            في BUBLE STORE DZ، نلتزم باختيار وتجربة كل منتج بعناية لنضمن لكم جودة تدوم وتلبي تطلعاتكم. نسهر على خدمتكم بكل أمان من لحظة الطلب حتى استلام الطرد عند باب منزلكم.
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-sm backdrop-blur-md transition hover:border-brand-gold/40 hover:bg-white/[0.1]">
              <div class="text-2xl">🚚</div>
              <h3 class="mt-2 text-sm font-bold text-white">شحن سريع لـ 69 ولاية</h3>
              <p class="mt-1 text-xs text-slate-300">توصيل آمن إلى باب داركم مع تأكيد فوري ومسبق عبر الهاتف.</p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-sm backdrop-blur-md transition hover:border-brand-gold/40 hover:bg-white/[0.1]">
              <div class="text-2xl">💵</div>
              <h3 class="mt-2 text-sm font-bold text-white">الدفع عند الاستلام</h3>
              <p class="mt-1 text-xs text-slate-300">ادفع نقداً بكل راحة بال عند استلام طلبيتك وفحصها.</p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-sm backdrop-blur-md transition hover:border-brand-gold/40 hover:bg-white/[0.1]">
              <div class="text-2xl">🔍</div>
              <h3 class="mt-2 text-sm font-bold text-white">المعاينة قبل الدفع</h3>
              <p class="mt-1 text-xs text-slate-300">يحق لك فتح الطرد والتأكد من مطابقة وجودة المنتج قبل تسليم المبلغ.</p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-sm backdrop-blur-md transition hover:border-brand-gold/40 hover:bg-white/[0.1]">
              <div class="text-2xl">📞</div>
              <h3 class="mt-2 text-sm font-bold text-white">خدمة عملاء 7 أيام / 7</h3>
              <p class="mt-1 text-xs text-slate-300">فريق متجاوب عبر الهاتف وواتساب لمرافقتكم والإجابة عن كل استفسار.</p>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/ar/catalogue" class="btn-primary !bg-brand-grenat hover:!bg-brand-grenatdark !text-white !px-7 !py-3 shadow-grenat">
              تصفح التشكيلة الكاملة
            </a>
            <a href="/ar/contact" class="btn-secondary !border-white/20 !bg-white/10 !text-white hover:!bg-white hover:!text-brand-navy backdrop-blur">
              تواصل مع خدمة العملاء
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>

  <script>
    import { initLiveProductSync } from '../../scripts/live-sync';
    initLiveProductSync({
      containerId: 'products-showcase-grid-ar',
      locale: 'ar',
      emptyPlaceholderId: 'sync-placeholder-ar'
    });
  </script>
</MainLayout>
