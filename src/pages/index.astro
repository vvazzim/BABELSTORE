---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAvailableColors, getCatalogProducts, getNewArrivalProducts, getPopularProducts, getPromotionProducts, getProducts } from '../lib/product-source';

const products = await getProducts();
const catalogProducts = getCatalogProducts(products);
const promotions = getPromotionProducts(catalogProducts);
const popularProducts = getPopularProducts(catalogProducts);
const newProducts = getNewArrivalProducts(catalogProducts);
---

<MainLayout title="Accueil" description="BABEL STORE - Sélection exclusive de produits tendance, pratiques et élégants pour le quotidien en Algérie.">
  <Hero locale="fr" />

  <section class="section-shell pt-4">
    <div class="container-shell space-y-14">
      <!-- Section Principale : Nos Produits -->
      <section>
        <SectionTitle
          eyebrow="Notre Sélection"
          title="Produits Disponibles"
          copy="Découvrez nos articles rigoureusement sélectionnés. Livraison rapide 58 wilayas et paiement à la réception."
        />
        <div
          id="products-showcase-grid"
          class:list={[
            'mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
            catalogProducts.length === 0 ? 'hidden' : ''
          ]}
        >
          {catalogProducts.map((product) => (
            <ProductCard product={product} availableColors={getAvailableColors(products, product.slug, product.variantGroup)} />
          ))}
        </div>

        {catalogProducts.length === 0 && (
          <div id="sync-placeholder" class="mt-8 rounded-3xl border border-brand-line bg-white/80 p-12 text-center shadow-soft">
            <p class="text-lg font-semibold text-brand-charcoal">Synchronisation en cours...</p>
            <p class="mt-2 text-sm text-brand-muted">Vos produits sont chargés en direct depuis Google Sheets. Veuillez actualiser la page.</p>
          </div>
        )}
      </section>

      {promotions.length > 0 && catalogProducts.length > 3 && (
        <section>
          <SectionTitle eyebrow="Offres Spéciales" title="Sélection en Promotion" copy="Profitez de nos réductions exclusives du moment." />
          <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {promotions.map((product) => (
              <ProductCard product={product} availableColors={getAvailableColors(products, product.slug, product.variantGroup)} />
            ))}
          </div>
        </section>
      )}

      <!-- Reassurance Section BABEL STORE -->
      <section class="relative overflow-hidden rounded-[2.5rem] border border-[#DFD3C0] bg-gradient-to-br from-[#FAF5EE] to-[#EFE4D6] p-8 sm:p-12">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-cognac/30 bg-white/80 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-cognac">
            Engagement Qualité
          </span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-brand-charcoal sm:text-4xl">
            L'Expérience Shopping BABEL STORE
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-brand-muted sm:text-base">
            Chez Babel Store, chaque article est rigoureusement sélectionné et testé pour répondre à vos exigences de qualité, d'élégance et de praticité. Nous vous accompagnons de la commande jusqu'à la livraison à domicile.
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/70 bg-white/70 p-5 shadow-sm backdrop-blur">
              <div class="text-xl">🚚</div>
              <h3 class="mt-2 text-sm font-bold text-brand-charcoal">Livraison Rapide 58 Wilayas</h3>
              <p class="mt-1 text-xs text-brand-muted">Expédition sécurisée avec appel de confirmation avant livraison.</p>
            </div>

            <div class="rounded-2xl border border-white/70 bg-white/70 p-5 shadow-sm backdrop-blur">
              <div class="text-xl">💵</div>
              <h3 class="mt-2 text-sm font-bold text-brand-charcoal">Paiement à la Livraison (COD)</h3>
              <p class="mt-1 text-xs text-brand-muted">Vous réglez en espèces directement au livreur à la réception.</p>
            </div>

            <div class="rounded-2xl border border-white/70 bg-white/70 p-5 shadow-sm backdrop-blur">
              <div class="text-xl">🔍</div>
              <h3 class="mt-2 text-sm font-bold text-brand-charcoal">Vérification Avant Paiement</h3>
              <p class="mt-1 text-xs text-brand-muted">Ouvrez et inspectez votre colis en toute sérénité avant de payer.</p>
            </div>

            <div class="rounded-2xl border border-white/70 bg-white/70 p-5 shadow-sm backdrop-blur">
              <div class="text-xl">📞</div>
              <h3 class="mt-2 text-sm font-bold text-brand-charcoal">Service Client Réactif 7j/7</h3>
              <p class="mt-1 text-xs text-brand-muted">Une équipe dédiée joignable pour répondre à toutes vos questions.</p>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/catalogue" class="btn-primary !bg-brand-charcoal hover:!bg-brand-cognac !text-brand-goldsoft !px-7 !py-3">
              Explorer tout le catalogue
            </a>
            <a href="/contact" class="btn-secondary !border-[#DFD3C0] !bg-white">
              Contacter le service client
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>

  <script>
    import { initLiveProductSync } from '../scripts/live-sync';
    initLiveProductSync({
      containerId: 'products-showcase-grid',
      locale: 'fr',
      emptyPlaceholderId: 'sync-placeholder'
    });
  </script>
</MainLayout>
