---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAvailableColors, getCatalogProducts, getNewArrivalProducts, getPopularProducts, getPromotionProducts, getProducts } from '../lib/product-source';

const products = await getProducts();
const catalogProducts = getCatalogProducts(products);
const promotions = getPromotionProducts(catalogProducts);
const popularProducts = getPopularProducts(catalogProducts);
const newProducts = getNewArrivalProducts(catalogProducts);
---

<MainLayout title="Accueil" description="BUBLE STORE DZ - Sélection exclusive de produits tendance, pratiques et élégants pour le quotidien en Algérie.">
  <Hero locale="fr" />

  <section class="section-shell pt-4">
    <div class="container-shell space-y-14">
      <!-- Section Principale : Nos Produits -->
      <section>
        <SectionTitle
          eyebrow="Notre Sélection"
          title="Produits Disponibles"
          copy="Découvrez nos articles rigoureusement sélectionnés. Livraison rapide 69 wilayas et paiement à la réception."
        />
        <div
          id="products-showcase-grid"
          class:list={[
            'mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4',
            catalogProducts.length === 0 ? 'hidden' : ''
          ]}
        >
          {catalogProducts.map((product) => (
            <ProductCard product={product} availableColors={getAvailableColors(products, product.slug, product.variantGroup)} />
          ))}
        </div>

        {catalogProducts.length === 0 && (
          <div id="sync-placeholder" class="mt-8 rounded-3xl border border-brand-line bg-white/80 p-12 text-center shadow-soft">
            <p class="text-lg font-semibold text-brand-charcoal">Synchronisation en cours...</p>
            <p class="mt-2 text-sm text-brand-muted">Vos produits sont chargés en direct depuis Google Sheets. Veuillez actualiser la page.</p>
          </div>
        )}
      </section>

      {promotions.length > 0 && catalogProducts.length > 3 && (
        <section>
          <SectionTitle eyebrow="Offres Spéciales" title="Sélection en Promotion" copy="Profitez de nos réductions exclusives du moment." />
          <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
            {promotions.map((product) => (
              <ProductCard product={product} availableColors={getAvailableColors(products, product.slug, product.variantGroup)} />
            ))}
          </div>
        </section>
      )}

      <!-- Reassurance Section BUBLE STORE DZ : Bleu Nuit & Grenat Impérial -->
      <section class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-gradient-to-br from-[#0B132B] via-[#101D38] to-[#060B1A] p-8 text-white shadow-premium sm:p-12">
        <!-- Glows -->
        <div class="pointer-events-none absolute -right-16 -top-16 h-80 w-80 rounded-full bg-brand-grenat/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-16 -left-16 h-72 w-72 rounded-full bg-brand-blueaccent/20 blur-3xl"></div>

        <div class="relative max-w-3xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-grenat/50 bg-brand-grenat/20 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-goldsoft shadow-sm backdrop-blur">
            <span class="h-2 w-2 rounded-full bg-brand-grenat animate-pulse"></span>
            Engagement Qualité
          </span>
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
            L'Expérience Shopping BUBLE STORE DZ
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-slate-300 sm:text-base">
            Chez Buble Store DZ, chaque article est rigoureusement sélectionné et testé pour répondre à vos exigences de qualité, d'élégance et de praticité. Nous vous accompagnons de la commande jusqu'à la livraison à domicile.
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-sm backdrop-blur-md transition hover:border-brand-gold/40 hover:bg-white/[0.1]">
              <div class="text-2xl">🚚</div>
              <h3 class="mt-2 text-sm font-bold text-white">Livraison Rapide 69 Wilayas</h3>
              <p class="mt-1 text-xs text-slate-300">Expédition sécurisée avec appel de confirmation avant livraison.</p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-sm backdrop-blur-md transition hover:border-brand-gold/40 hover:bg-white/[0.1]">
              <div class="text-2xl">💵</div>
              <h3 class="mt-2 text-sm font-bold text-white">Paiement à la Livraison (COD)</h3>
              <p class="mt-1 text-xs text-slate-300">Vous réglez en espèces directement au livreur à la réception.</p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-sm backdrop-blur-md transition hover:border-brand-gold/40 hover:bg-white/[0.1]">
              <div class="text-2xl">🔍</div>
              <h3 class="mt-2 text-sm font-bold text-white">Vérification Avant Paiement</h3>
              <p class="mt-1 text-xs text-slate-300">Ouvrez et inspectez votre colis en toute sérénité avant de payer.</p>
            </div>

            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5 shadow-sm backdrop-blur-md transition hover:border-brand-gold/40 hover:bg-white/[0.1]">
              <div class="text-2xl">📞</div>
              <h3 class="mt-2 text-sm font-bold text-white">Service Client Réactif 7j/7</h3>
              <p class="mt-1 text-xs text-slate-300">Une équipe dédiée joignable pour répondre à toutes vos questions.</p>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/catalogue" class="btn-primary !bg-brand-grenat hover:!bg-brand-grenatdark !text-white !px-7 !py-3 shadow-grenat">
              Explorer tout le catalogue
            </a>
            <a href="/contact" class="btn-secondary !border-white/20 !bg-white/10 !text-white hover:!bg-white hover:!text-brand-navy backdrop-blur">
              Contacter le service client
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>

  <script>
    import { initLiveProductSync } from '../scripts/live-sync';
    initLiveProductSync({
      containerId: 'products-showcase-grid',
      locale: 'fr',
      emptyPlaceholderId: 'sync-placeholder'
    });
  </script>
</MainLayout>
