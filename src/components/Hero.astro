---
import { brandAssets } from '../data/site';
import { getSiteData, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
  descriptionText?: string;
}

const { locale = 'fr', descriptionText } = Astro.props as Props;
const siteData = getSiteData(locale);
---

<section class="section-shell pb-6 pt-6 sm:pt-10">
  <div class="container-shell">
    <div class="relative overflow-hidden rounded-[2.5rem] border border-[#DFD3C0] bg-gradient-to-br from-[#FAF5EE] via-[#F4ECE0] to-[#ECE2D4] p-8 shadow-soft sm:p-12 lg:p-16">
      <!-- Decorative Warm Light Accent -->
      <div class="pointer-events-none absolute -right-20 -top-20 h-96 w-96 rounded-full bg-brand-gold/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-20 h-80 w-80 rounded-full bg-brand-cognac/10 blur-3xl"></div>

      <div class="relative grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="max-w-2xl">
          {siteData.heroBadge && (
            <span class="inline-flex items-center gap-2 rounded-full border border-brand-cognac/30 bg-white/80 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-cognac shadow-sm backdrop-blur">
              <span class="h-2 w-2 rounded-full bg-brand-cognac"></span>
              {siteData.heroBadge}
            </span>
          )}

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-brand-charcoal sm:text-5xl lg:text-6xl">
            {siteData.brandName}
          </h1>

          <p class="mt-4 text-base font-semibold uppercase tracking-[0.14em] text-brand-cognac sm:text-lg">
            {siteData.tagline}
          </p>

          <p class="mt-5 max-w-xl text-sm leading-relaxed text-brand-muted sm:text-base">
            {descriptionText || siteData.description}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={siteData.primaryCTA.href} class="btn-primary !bg-brand-charcoal hover:!bg-brand-cognac !text-brand-goldsoft !px-8 !py-3.5 !text-base shadow-lg">
              {siteData.primaryCTA.label}
            </a>
            <a href={siteData.secondaryCTA.href} class="btn-secondary !border-[#DFD3C0] !bg-white/90 hover:!bg-white !px-7 !py-3.5 !text-base">
              {siteData.secondaryCTA.label}
            </a>
          </div>

          <!-- Trust highlights pills -->
          <div class="mt-10 flex flex-wrap gap-4 border-t border-[#DFD3C0]/70 pt-6 text-xs font-medium text-brand-charcoal">
            <div class="flex items-center gap-2">
              <span class="text-brand-cognac">✓</span> {locale === 'ar' ? 'توصيل سريع 58 ولاية' : 'Livraison 58 Wilayas'}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-cognac">✓</span> {locale === 'ar' ? 'الدفع عند الاستلام (COD)' : 'Paiement à la livraison'}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-cognac">✓</span> {locale === 'ar' ? 'معاينة الطرد قبل الدفع' : 'Vérification avant paiement'}
            </div>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="relative overflow-hidden rounded-[2.2rem] border-2 border-[#DFD3C0] bg-white p-3 shadow-premium transition duration-500 hover:scale-[1.02]">
            <img 
              src={brandAssets.banner} 
              alt={`${siteData.brandName} Concept Visuel`} 
              class="h-72 w-72 rounded-[1.8rem] object-cover sm:h-88 sm:w-88 lg:h-[26rem] lg:w-[22rem]" 
            />
            <div class="absolute bottom-5 left-5 right-5 rounded-2xl border border-white/40 bg-white/90 p-3 shadow-sm backdrop-blur-md">
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-xs font-bold tracking-wider text-brand-charcoal">BABEL COLLECTION</div>
                  <div class="text-[11px] text-brand-muted">{locale === 'ar' ? 'أناقة وابتكار يومي' : 'Élégance & Utilité au quotidien'}</div>
                </div>
                <span class="rounded-full bg-brand-goldsoft px-2.5 py-1 text-[10px] font-bold text-brand-cognac">
                  {locale === 'ar' ? 'حصري' : 'PREMIUM'}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
