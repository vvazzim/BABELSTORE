---
import { brandAssets } from '../data/site';
import { getSiteData, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
  descriptionText?: string;
}

const { locale = 'fr', descriptionText } = Astro.props as Props;
const siteData = getSiteData(locale);
---

<section class="section-shell pb-6 pt-6 sm:pt-10">
  <div class="container-shell">
    <div class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-gradient-to-br from-[#0B132B] via-[#101D38] to-[#060B1A] p-8 shadow-premium sm:p-12 lg:p-16 text-white">
      <!-- Decorative Lighting Accents : Grenat & Bleu Saphir -->
      <div class="pointer-events-none absolute -right-20 -top-20 h-96 w-96 rounded-full bg-brand-grenat/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-20 h-80 w-80 rounded-full bg-brand-blueaccent/20 blur-3xl"></div>
      <div class="pointer-events-none absolute right-1/3 top-1/2 h-64 w-64 rounded-full bg-brand-gold/15 blur-2xl"></div>

      <div class="relative grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="max-w-2xl">
          {siteData.heroBadge && (
            <span class="inline-flex items-center gap-2 rounded-full border border-brand-grenat/50 bg-brand-grenat/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white shadow-sm backdrop-blur">
              <span class="h-2 w-2 rounded-full bg-brand-grenat animate-pulse"></span>
              {siteData.heroBadge}
            </span>
          )}

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
            {siteData.brandName}
          </h1>

          <p class="mt-4 text-base font-semibold uppercase tracking-[0.14em] text-brand-gold sm:text-lg">
            {siteData.tagline}
          </p>

          <p class="mt-5 max-w-xl text-sm leading-relaxed text-slate-300 sm:text-base">
            {descriptionText || siteData.description}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={siteData.primaryCTA.href} class="btn-primary !bg-brand-grenat hover:!bg-brand-grenatdark !text-white !px-8 !py-3.5 !text-base shadow-grenat">
              {siteData.primaryCTA.label}
            </a>
            <a href={siteData.secondaryCTA.href} class="btn-secondary !border-white/20 !bg-white/10 !text-white hover:!bg-white hover:!text-brand-navy !px-7 !py-3.5 !text-base backdrop-blur">
              {siteData.secondaryCTA.label}
            </a>
          </div>

          <!-- Trust highlights pills -->
          <div class="mt-10 flex flex-wrap gap-4 border-t border-white/15 pt-6 text-xs font-medium text-slate-300">
            <div class="flex items-center gap-2">
              <span class="text-brand-gold font-bold">✓</span> {locale === 'ar' ? 'توصيل سريع 58 ولاية' : 'Livraison 58 Wilayas'}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-gold font-bold">✓</span> {locale === 'ar' ? 'الدفع عند الاستلام (COD)' : 'Paiement à la livraison'}
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-gold font-bold">✓</span> {locale === 'ar' ? 'معاينة الطرد قبل الدفع' : 'Vérification avant paiement'}
            </div>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="relative overflow-hidden rounded-[2.2rem] border-2 border-brand-gold/40 bg-white/5 p-3 shadow-premium backdrop-blur transition duration-500 hover:scale-[1.02]">
            <img 
              src={brandAssets.banner} 
              alt={`${siteData.brandName} Concept Visuel`} 
              class="h-72 w-72 rounded-[1.8rem] object-cover sm:h-88 sm:w-88 lg:h-[26rem] lg:w-[22rem]" 
            />
            <div class="absolute bottom-5 left-5 right-5 rounded-2xl border border-white/20 bg-brand-navydark/85 p-3.5 shadow-lg backdrop-blur-md">
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-xs font-bold tracking-wider text-brand-gold">BUBLE COLLECTION</div>
                  <div class="text-[11px] text-slate-300">{locale === 'ar' ? 'أناقة وابتكار يومي' : 'Élégance & Utilité au quotidien'}</div>
                </div>
                <span class="rounded-full bg-brand-grenat px-3 py-1 text-[10px] font-bold text-white shadow-sm">
                  {locale === 'ar' ? 'حصري' : 'PREMIUM'}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
