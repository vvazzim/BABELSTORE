---
import { getSiteData, type Locale, uiText, withLocalePath } from '../lib/i18n';

interface Props {
  title?: string;
  copy?: string;
  locale?: Locale;
}

const {
  locale = 'fr',
  title = locale === 'ar' ? 'متجر متكامل مصمم لأناقتك وراحتك اليومية' : 'Une boutique pensée pour le quotidien et les idées tendances',
  copy = locale === 'ar' ? 'تصفح تشكيلتنا الحصرية المختارة بعناية لتجمع بين الفائدة الحقيقية والجمال العصري.' : 'Parcourez une sélection exclusive pensée pour simplifier et embellir chaque moment de votre quotidien.'
} = Astro.props as Props;
const siteData = getSiteData(locale);
---

<section class="section-shell pt-0">
  <div class="container-shell">
    <div class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-gradient-to-br from-[#0B132B] via-[#101D38] to-[#060B1A] px-8 py-12 text-white shadow-premium sm:px-12">
      <!-- Glows -->
      <div class="pointer-events-none absolute -right-10 -top-10 h-72 w-72 rounded-full bg-brand-grenat/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-10 -left-10 h-64 w-64 rounded-full bg-brand-blueaccent/20 blur-3xl"></div>

      <div class="relative max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-grenat/50 bg-brand-grenat/20 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-goldsoft shadow-sm backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-brand-grenat animate-pulse"></span>
          BABEL STORE
        </span>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">{copy}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={siteData.primaryCTA.href} class="btn-primary !bg-brand-grenat hover:!bg-brand-grenatdark !text-white !px-7 !py-3.5 shadow-grenat">{siteData.primaryCTA.label}</a>
          <a href={withLocalePath('/contact', locale)} class="btn-secondary !border-white/20 !bg-white/10 !text-white hover:!bg-white hover:!text-brand-navy !px-7 !py-3.5 backdrop-blur">{uiText[locale].buttons.contactBrand}</a>
        </div>
      </div>
    </div>
  </div>
</section>
