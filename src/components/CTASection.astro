---
import { getSiteData, type Locale, uiText, withLocalePath } from '../lib/i18n';

interface Props {
  title?: string;
  copy?: string;
  locale?: Locale;
}

const {
  locale = 'fr',
  title = locale === 'ar' ? 'متجر متكامل مصمم لأناقتك وراحتك اليومية' : 'Une boutique pensée pour le quotidien et les idées tendances',
  copy = locale === 'ar' ? 'تصفح تشكيلتنا الحصرية المختارة بعناية لتجمع بين الفائدة الحقيقية والجمال العصري.' : 'Parcourez une sélection exclusive pensée pour simplifier et embellir chaque moment de votre quotidien.'
} = Astro.props as Props;
const siteData = getSiteData(locale);
---

<section class="section-shell pt-0">
  <div class="container-shell">
    <div class="overflow-hidden rounded-[2.5rem] border border-[#DFD3C0] bg-gradient-to-br from-[#FAF5EE] via-[#F4ECE0] to-[#ECE2D4] px-8 py-12 shadow-soft sm:px-12">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-cognac/30 bg-white/80 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-cognac shadow-sm">
          BABEL STORE
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-brand-charcoal sm:text-4xl">{title}</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-brand-muted sm:text-base">{copy}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={siteData.primaryCTA.href} class="btn-primary !bg-brand-charcoal hover:!bg-brand-cognac !text-brand-goldsoft !px-7 !py-3.5">{siteData.primaryCTA.label}</a>
          <a href={withLocalePath('/contact', locale)} class="btn-secondary !border-[#DFD3C0] !bg-white !px-7 !py-3.5">{uiText[locale].buttons.contactBrand}</a>
        </div>
      </div>
    </div>
  </div>
</section>
